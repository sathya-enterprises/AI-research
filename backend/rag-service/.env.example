# Optional Hugging Face configuration for the RAG reranker.
# Leave HF_TOKEN blank for public models; never commit a real token here.
HF_TOKEN=
RAG_HOST=127.0.0.1
RAG_PORT=7860
SUPABASE_URL=
SUPABASE_ANON_KEY=
OKF_SUPABASE_BUCKET=paperly-uploads
# Private destination. Create and verify the bucket separately before enabling.
OKF_PRIVATE_BUCKET=rag-knowledge-private
# Preferred backend-only Storage credential (Supabase sb_secret_...); never expose to clients.
SUPABASE_SECRET_KEY=
# Backwards compatibility for legacy JWT service-role keys; prefer SUPABASE_SECRET_KEY.
SUPABASE_SERVICE_ROLE_KEY=
# Keep disabled. New writes use the private bucket when its server-side credential is configured.
OKF_ALLOW_LEGACY_PUBLIC_WRITES=0
EMBED_MODEL=all-MiniLM-L6-v2
HF_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HF_RERANK_ENABLED=1
HF_RERANK_CANDIDATES=24
HF_RERANK_BATCH_SIZE=16

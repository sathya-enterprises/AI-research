# Server-only credential for website article ingestion to the FastAPI backend.
# Must match backend/.env ARTICLE_KB_INGEST_TOKEN. Do not use NEXT_PUBLIC_.
ARTICLE_KB_INGEST_TOKEN=replace-with-the-same-random-secret-as-backend

# Existing frontend/backend configuration examples (fill only where needed).
# BACKEND_URL=http://127.0.0.1:10000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Article knowledge base (feed articles -> backend -> Supabase, reused by reports).
# Must match ARTICLE_KB_INGEST_TOKEN in backend/.env; without it only signed-in users' reads are stored.
# ARTICLE_KB_INGEST_TOKEN=
# When the backend is unreachable, articles are kept in a local spool and replayed later.
# ARTICLE_KB_SPOOL=1                     # 0 disables the spool
# ARTICLE_KB_SPOOL_DIR=                  # default: frontend/.cache
# ARTICLE_KB_BACKOFF_MS=60000            # pause after a connection failure
# ARTICLE_KB_SPOOL_MAX_RECORDS=20000

# Must point to the same local/deployed RAG service used by backend/.env.
RAG_SERVICE_URL=http://127.0.0.1:7860

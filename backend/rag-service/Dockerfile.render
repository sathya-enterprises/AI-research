FROM python:3.11-slim

# System deps for sentence-transformers and faiss
RUN apt-get update && apt-get install -y \
    build-essential \
    libgfortran5 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python deps (heavy — do this layer first for cache efficiency)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download the embedding model so the container starts faster
# Model is cached in /root/.cache/huggingface
RUN python -c "import os; os.environ['HF_HOME']='/home/user/.cache/huggingface'; from sentence_transformers import SentenceTransformer, CrossEncoder; SentenceTransformer(os.getenv('EMBED_MODEL','all-MiniLM-L6-v2')); CrossEncoder(os.getenv('HF_RERANK_MODEL','cross-encoder/ms-marco-MiniLM-L6-v2')) if os.getenv('HF_RERANK_ENABLED','1').lower() not in {'0','false','no','off'} else None"

# Copy source
COPY . .

ENV RAG_PORT=7860 RAG_HOST=0.0.0.0
EXPOSE 7860

HEALTHCHECK --interval=20s --timeout=8s --start-period=40s --retries=3 \
  CMD python -c "import httpx; r=httpx.get('http://localhost:7860/health',timeout=5); r.raise_for_status()"

CMD ["python", "main.py"]

# Place this file in the project root (the folder that contains backend/ and frontend/).

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
frontend/.next/
frontend/.next-*/
frontend/out/
frontend/build/
frontend/.pnp
frontend/.pnp.*
frontend/.yarn/*
!frontend/.yarn/patches
!frontend/.yarn/plugins
!frontend/.yarn/releases
!frontend/.yarn/versions
frontend/coverage/
*.tsbuildinfo
frontend/next-env.d.ts

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Env & secrets ─────────────────────────────────────────────────────────────
.env
.env.local
.env.*
!.env.example
*.pem

# ── Runtime cache / generated data ────────────────────────────────────────────
growth_gradual_cache.json
market_cache.json
backend/artifacts/
backend/data/

# ── Local research diagnostic captures ────────────────────────────────────────
backend/diagnostics/research_capture_*.json
backend/diagnostics/*.json.tmp
backend/diagnostics/research-captures/*.json

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / editor / platform ────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.vercel
# Optional Hugging Face reranker configuration for the RAG service.
HF_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
HF_RERANK_CANDIDATES=24

# ── Security (required) ───────────────────────────────────────────────────────
# Shared secret with the backend; every endpoint except /ping and /health requires it (X-RAG-Service-Token).
# Without it the service refuses requests (fail closed). Same value as the backend's RAG_SERVICE_TOKEN.
RAG_SERVICE_TOKEN=
# Local development only, never in production: allow unauthenticated calls when no token is set.
# RAG_ALLOW_UNAUTHENTICATED=1
# Recommended: lets session-ownership changes run as atomic Postgres transactions.
# RESEARCH_DATABASE_URL=

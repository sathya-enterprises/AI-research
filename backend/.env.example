# Server-to-server token for website article ingestion.
# Must exactly match frontend/.env.local ARTICLE_KB_INGEST_TOKEN.
# Generate a random value locally; do not commit or share the real value.
ARTICLE_KB_INGEST_TOKEN=replace-with-the-same-random-secret-as-frontend

# Existing values omitted on purpose; configure these separately.
# Supabase Storage: the reports endpoint reads existing OKF Markdown docs from the private bucket first.
# This key is backend-only; prefer SUPABASE_SECRET_KEY (new key format) or the legacy service-role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-only-service-role-jwt
# OKF_PRIVATE_BUCKET=rag-knowledge-private
# OKF_SUPABASE_BUCKET=paperly-uploads
# Supabase Postgres connection for the shared web crawl/research library:
# RESEARCH_DATABASE_URL=postgresql://...

# Bounded concurrency for report source enrichment and internal site crawling.
# Defaults are suitable for moderate provider quotas; lower them if rate limits increase.
GG_REPORT_SOURCE_CONCURRENCY=10
GG_REPORT_CRAWL_CONCURRENCY=7

# Evidence-backed chart gallery (tries every chart type the extracted figures can honestly support).
# all = full catalog (default) | core = common types only | off = disabled.
REPORT_CHART_GALLERY=core
# inline = each chart sits in the section that discusses its metric; section = one "Data and Charts" section.
REPORT_CHART_GALLERY_LAYOUT=inline
REPORT_ACCEPT_SEARCH_EXTRACT_EVIDENCE=1
EXA_REPORT_TEXT_CHARS=12000

# Supabase: paste the bare project URL, e.g. https://abcdxyz.supabase.co (no quotes, no /rest/v1).
# Leave SCREENER_SUPABASE_URL unset unless the screener data lives in a DIFFERENT project;
# if it is set but does not resolve, the backend now falls back to SUPABASE_URL and logs a warning.
# SUPABASE_URL=https://your-project.supabase.co

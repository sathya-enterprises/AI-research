# Server-only credential for website article ingestion to the FastAPI backend.
# Must match backend/.env ARTICLE_KB_INGEST_TOKEN. Do not use NEXT_PUBLIC_.
ARTICLE_KB_INGEST_TOKEN=replace-with-the-same-random-secret-as-backend

# Existing frontend/backend configuration examples (fill only where needed).
# BACKEND_URL=http://127.0.0.1:10000
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key

# Server-to-server token for website article ingestion.
# Must exactly match frontend/.env.local ARTICLE_KB_INGEST_TOKEN.
# Generate a random value locally; do not commit or share the real value.
ARTICLE_KB_INGEST_TOKEN=replace-with-the-same-random-secret-as-frontend

# Existing values omitted on purpose; configure these separately.
# Supabase Storage: the reports endpoint reads existing OKF Markdown docs from the private bucket first.
# This key is backend-only; prefer SUPABASE_SECRET_KEY (new key format) or the legacy service-role key.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
# SUPABASE_SECRET_KEY=your-server-only-secret-key
# SUPABASE_SERVICE_ROLE_KEY=legacy-server-only-service-role-jwt
# OKF_PRIVATE_BUCKET=rag-knowledge-private
# OKF_SUPABASE_BUCKET=paperly-uploads
# Supabase Postgres connection for the shared web crawl/research library:
# RESEARCH_DATABASE_URL=postgresql://...

# Bounded concurrency for report source enrichment and internal site crawling.
# Defaults are suitable for moderate provider quotas; lower them if rate limits increase.
GG_REPORT_SOURCE_CONCURRENCY=10
GG_REPORT_CRAWL_CONCURRENCY=7

# Per-tier data-point capacity, as "brief,detailed,in_depth" (defaults shown).
# Raising these scrapes more sources/observations at the cost of more search calls and longer jobs.
# REPORT_TIER_SEARCH_LIMITS=20,60,100          # Exa results per query (Exa max is 100)
# REPORT_TIER_ENRICH_LIMITS=20,50,80           # publisher pages fetched and extracted
# REPORT_TIER_CRAWL_PAGES=6,24,48              # internal pages crawled from verified sources
# REPORT_TIER_NUMERIC_OBSERVATIONS=120,250,400 # sourced numbers handed to the report writer
# REPORT_TIER_EVIDENCE_CONTEXT_CHARS=40000,85000,140000

# Report house styles (chosen per report in the UI: Market Currents or Feature Article).
# Registration line in the Market Currents footer:
# REPORT_BRAND_ARN=ARN-351151, Validity Jan'29

# Evidence-backed chart gallery (tries every chart type the extracted figures can honestly support).
# all = full catalog (default) | core = common types only | off = disabled.
REPORT_CHART_GALLERY=all
# inline = each chart sits in the section that discusses its metric; section = one "Data and Charts" section.
REPORT_CHART_GALLERY_LAYOUT=inline
REPORT_ACCEPT_SEARCH_EXTRACT_EVIDENCE=1
EXA_REPORT_TEXT_CHARS=12000

# Supabase: paste the bare project URL, e.g. https://abcdxyz.supabase.co (no quotes, no /rest/v1).
# Leave SCREENER_SUPABASE_URL unset unless the screener data lives in a DIFFERENT project;
# if it is set but does not resolve, the backend now falls back to SUPABASE_URL and logs a warning.
# SUPABASE_URL=https://your-project.supabase.co

# ── LLM call scheduling and research speed (v94) — all optional; defaults shown ──
# Report writer: start 1 request per model and add a hedge (another key) only if no
# answer after this many seconds. 0 = old behaviour (whole wave fires at once).
# Default by tier when unset: brief 10, detailed 15, in_depth 20.
# GEMINI_REPORT_HEDGE_DELAY_SECONDS=
# GEMINI_REPORT_WAVE_SIZE=4
# Evidence analysts: per-call timeout (default by tier 10/12/14 s), stage deadline,
# primary model for every analyst (default: first configured model, flash-lite).
# REPORT_PARALLEL_REQUEST_TIMEOUT_SECONDS=
# REPORT_PARALLEL_ANALYSIS_DEADLINE_SECONDS=20
# REPORT_PARALLEL_PRIMARY_MODEL=gemini-3.5-flash-lite
# REPORT_PARALLEL_SPREAD_MODELS=0
# REPORT_PARALLEL_GROQ_TIMEOUT_SECONDS=11
# Independent audit: hedged = 1 reviewer + 1 hedge, first valid verdict (default);
# parallel = old 4-8 simultaneous reviewers, most severe verdict wins.
# GG_AUDIT_STRATEGY=hedged
# GG_AUDIT_REQUEST_TIMEOUT_SECONDS=20
# GG_AUDIT_HEDGE_SECONDS=9
# Page-band expansion: hard cap on LLM expansion + PDF preflight rounds (0 = tier default).
# GG_PAGE_BUDGET_MAX_ROUNDS=0
# Source fetching: topic ranking for questions without company names, PDF parse
# budget per document (runs in a worker thread), whole-download deadline.
# GG_REPORT_TOPIC_RANKING=1
# GG_PDF_EXTRACT_BUDGET_SECONDS=8
# GG_SOURCE_FETCH_TOTAL_SECONDS=20
# Reports: add stored full-text feed articles (opened in the reader) for news/market questions.
# GG_REPORT_USE_NEWS_KB=1
# GG_REPORT_NEWS_KB_MAX_AGE_DAYS=45
